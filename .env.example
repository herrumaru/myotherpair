# ============================================================
# apps/api/.env  — Copy and fill in real values
# ============================================================

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/myotherpair

# Supabase (shared between api and web)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# apps/web/.env.local  — Copy relevant vars here too
# ============================================================

# Supabase (public keys — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role (server-side API routes only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email notifications)
RESEND_API_KEY=re_...

# App base URL (used in email links and Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
